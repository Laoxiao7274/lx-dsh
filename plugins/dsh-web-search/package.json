{
  "name": "@laoxiao7274/dsh-web-search",
  "description": "DSH 网页搜索插件：Exa MCP / Tavily / Brave / Jina / Kagi / Perplexity，pi-web-access 原生 curator 审核页面，模型总结。",
  "version": "1.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "private": true,
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ]
}
